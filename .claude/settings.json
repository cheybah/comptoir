{
  "permissions": {
    "allow": ["mcp__comptoir-db"]
  },
  "hooks": {
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-after-edit.sh",
          "timeout": 60,
