  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.25",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
