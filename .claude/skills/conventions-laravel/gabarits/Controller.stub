<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Http\Requests\Store{{ Model }}Request;
use App\Http\Resources\{{ Model }}Resource;
use App\Models\{{ Model }};
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;

final class {{ Model }}Controller extends Controller
{
    /**
     * GET /api/{{ models }}
     */
    public function index(): AnonymousResourceCollection
    {
        ${{ models }} = {{ Model }}::query()
            ->with([/* relations lues par la Resource */])
            ->latest()
            ->paginate(50);

        return {{ Model }}Resource::collection(${{ models }});
    }

    /**
     * GET /api/{{ models }}/{{{ model }}}
     */
    public function show({{ Model }} ${{ model }}): {{ Model }}Resource
    {
        return {{ Model }}Resource::make(${{ model }}->load([/* relations */]));
    }

    /**
     * POST /api/{{ models }}
     */
    public function store(Store{{ Model }}Request $request): JsonResponse
    {
        ${{ model }} = {{ Model }}::create($request->validated());

        return {{ Model }}Resource::make(${{ model }})
            ->response()
            ->setStatusCode(201);
    }
}
